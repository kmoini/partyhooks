{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.partyhooks.com" }],
      "destination": "https://partyhooks.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://snapdance-production.up.railway.app/api/$1"
    }
  ]
}
